    <!-- Status Bar -->
    <dimen name="status_bar_padding_start">20.0px</dimen>
    <dimen name="status_bar_padding_end">8.0px</dimen>

    <!-- Keyguard -->
    <dimen name="keyguard_indication_margin_bottom">14dp</dimen>
