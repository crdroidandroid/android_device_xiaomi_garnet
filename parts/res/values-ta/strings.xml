    <!-- Auto HBM -->
    <string name="auto_hbm_title">தானியங்கி உயர் பிரகாச பயன்முறை (HBM)</string>
    <string name="auto_hbm_main_switch_title">தானியங்கி HBM ஐப் பயன்படுத்து</string>
    <string name="tile_auto_hbm">தானியங்கி HBM</string>
    <string name="tile_hbm_on">இயக்கப்பட்டது</string>
    <string name="tile_hbm_off">முடக்கப்பட்டது</string>
    <string name="tile_hbm">HBM</string>
    <string name="tile_hbm_unavailable">HBM கிடைக்கவில்லை</string>
    <string name="tile_auto_hbm_or_brightness_enabled">தானியங்கி HBM அல்லது தானியங்கி பிரகாசம் இயக்கப்பட்டுள்ளது</string>
    <string name="hbm_mode_title">உயர் பிரகாச பயன்முறை</string>
    <string name="hbm_mode_notification">உயர் பிரகாச பயன்முறை இப்போது செயல்படுத்தப்பட்டுள்ளது. நீண்ட நேர பயன்பாடு உங்கள் திரையை சேதப்படுத்தலாம்.</string>
    <string name="auto_hbm_summary">சூரிய ஒளியின் தீவிரத்தின் (lux) அடிப்படையில் உயர் பிரகாச பயன்முறையை தானாகவே இயக்கவும்</string>
    <string name="auto_hbm_threshold_title">ஒளி வரம்பு</string>
    <string name="auto_hbm_threshold_summary">HBM செயல்படுத்தப்படும் lux அலகுகளில் ஒளி தீவிர வரம்பை வரையறுக்கவும்</string>
    <string name="auto_hbm_enable_time_title">இயக்கும் நேரம்</string>
    <string name="auto_hbm_enable_time_summary">HBM ஐ செயல்படுத்த ஒளி வரம்பு தொடர்ந்து பூர்த்தி செய்யப்பட வேண்டிய வினாடிகளில் கால அளவு</string>
    <string name="auto_hbm_disable_time_title">முடக்கும் நேரம்</string>
    <string name="auto_hbm_disable_time_summary">ஒளி வரம்பு அமைக்கப்பட்ட அளவுக்குக் கீழே குறைந்தால் HBM முடக்கப்படும் வினாடிகளில் கால அளவு</string>

