    <!-- Clear Speaker -->
   <string name="clear_speaker_title">ஒலிப்பெருக்கியை சுத்தம் செய்</string>
   <string name="clear_speaker_summary">ஒலிப்பெருக்கியை சுத்தம் செய்ய 30 வினாடி ஆடியோவை இயக்கவும்</string>
   <string name="clear_speaker_description">உங்கள் ஒலிப்பெருக்கி தூசியால் லேசாக அடைக்கப்பட்டிருந்தால் இந்த அம்சத்தை ஒன்று அல்லது இரண்டு முறை இயக்கவும். மீடியா ஒலியளவை அதிகபட்சமாக அமைக்கவும்.\n\nஒலிப்பெருக்கி அதிகமாக அடைக்கப்பட்டிருந்தால், ஒலிப்பெருக்கி கீழ்நோக்கி இருக்கும் வகையில் சாதனத்தை அசைத்து இந்த அம்சத்தை 2-5 முறை இயக்கவும்.</string>

